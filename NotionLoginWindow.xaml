<Window x:Class="AIUsageChecker.NotionLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Notion AIに接続" Width="900" Height="680" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource AppBackground}"
        Icon="Assets/app-icon.ico">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Notionへログインしてください" FontWeight="Bold" FontSize="18"/>
          <TextBlock x:Name="StatusText" Text="ログイン完了を検出すると自動で接続します。" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" LineHeight="21"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="キャンセル" Click="Cancel_Click"/>
      </Grid>
    </Border>
    <wv2:WebView2 x:Name="Browser" Grid.Row="1" NavigationCompleted="Browser_NavigationCompleted"/>
  </Grid>
</Window>
