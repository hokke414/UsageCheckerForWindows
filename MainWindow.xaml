<Window x:Class="AIUsageChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Usage Checker" Width="1060" Height="760" Icon="Assets/app-icon.ico"
        MinWidth="880" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource TextPrimary}">
  <Grid Margin="28" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="18"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="AI Usage Checker" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="利用中のAIサービスの残量と更新時刻を、ひとつの画面で確認できます。" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource TextSecondary}"/>
          <TextBlock Text="  ·  " Foreground="#607080"/>
          <TextBlock Text="{Binding LastCheckedText}" Foreground="{StaticResource TextSecondary}"/>
          <TextBlock Text="  ·  5分ごとに自動更新" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource SecondaryButton}" Click="Settings_Click" Margin="0,0,8,0"
                AutomationProperties.Name="設定を開く" Content="設定"/>
        <Button Style="{StaticResource PrimaryButton}" Click="Refresh_Click"
                IsEnabled="{Binding IsNotRefreshing}" AutomationProperties.Name="利用量を今すぐ確認">
          <TextBlock Text="{Binding RefreshButtonText}"/>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="520"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding VisibleProviders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                      CornerRadius="8" Padding="18" Margin="0,0,12,12" MinHeight="238">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="6" Background="{StaticResource PrimarySoft}" BorderBrush="{Binding AccentBrush}" BorderThickness="2">
                      <TextBlock Text="{Binding ShortName}" Foreground="{Binding AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,6,0">
                      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"/>
                      <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceRaised}" BorderBrush="{Binding StateBrush}" BorderThickness="1" CornerRadius="4" Padding="9,5" VerticalAlignment="Top">
                      <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="Bold"/>
                    </Border>
                  </Grid>

                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding RemainingDisplay}" FontSize="18" FontWeight="Bold"/>
                      <TextBlock Text="{Binding UsageDisplay}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PercentDisplay}" Foreground="{Binding StateBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </Grid>

                  <Grid Grid.Row="4">
                    <ProgressBar Height="9" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding StateBrush}" Background="#D9DEE8" BorderThickness="0"/>
                  </Grid>
                  <Grid Grid.Row="5" Margin="0,10,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ResetDisplay}" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SourceDisplay}" Foreground="{Binding SourceBrush}" FontWeight="Bold" ToolTip="{Binding AutoDetail}"/>
                  </Grid>

                  <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="OpenUsage_Click" AutomationProperties.Name="公式の使用量画面を開く">
                      <TextBlock Text="公式画面"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Edit_Click" AutomationProperties.Name="使用量を記録">
                      <TextBlock Text="記録する"/>
                    </Button>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="使用量を記録" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding EditorTitle}" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,18" TextWrapping="Wrap"/>

            <TextBlock Text="使用済み" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding EditUsed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="使用済みの量"/>

            <TextBlock Text="上限" FontWeight="Bold" Margin="0,16,0,6"/>
            <TextBox Text="{Binding EditLimit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="使用量の上限"/>

            <TextBlock Text="単位" FontWeight="Bold" Margin="0,16,0,6"/>
            <TextBox Text="{Binding EditUnit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="使用量の単位"/>

            <TextBlock Text="更新日時" FontWeight="Bold" Margin="0,16,0,6"/>
            <TextBox Text="{Binding EditResetAt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="更新日時"/>
            <TextBlock Text="例: 2026/10/01 18:30（空欄でも可）" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="メモ" FontWeight="Bold" Margin="0,16,0,6"/>
            <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" Height="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="メモ"/>

            <TextBlock Text="{Binding EditorError}" Foreground="{Binding EditorMessageBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Border Background="#F5F5F5" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,0" CornerRadius="4" Padding="12" Margin="0,16,0,0">
              <TextBlock Text="{Binding EditorGuidance}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
            </Border>

            <Button Style="{StaticResource PrimaryButton}" Content="保存" Margin="0,18,0,0" Click="Save_Click" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="記録を保存"/>
            <Button Style="{StaticResource SecondaryButton}" Content="ヘルプを開く" Margin="0,8,0,0" Click="OpenHelp_Click" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="公式ヘルプを開く"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="認証情報と使用量キャッシュは、このPC内だけで管理されます。" Foreground="{StaticResource TextSecondary}"/>
      <TextBlock Text="v1.2" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
    </Grid>
    <wv2:WebView2 x:Name="GeminiUsageBrowser" Width="1" Height="1" Margin="-100,-100,0,0"
                  IsHitTestVisible="False" Focusable="False"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
  </Grid>
</Window>
