<Window x:Class="AIUsageChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Usage Checker" Width="760" Height="520" Icon="Assets/app-icon.ico"
        MinWidth="640" MinHeight="440" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource TextPrimary}">
  <Grid Margin="20" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="AI Usage Checker" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource CompactSecondaryButton}" Click="Settings_Click" Margin="0,0,8,0"
                AutomationProperties.Name="設定を開く" Content="設定"/>
        <Button Style="{StaticResource CompactPrimaryButton}" Click="Refresh_Click"
                IsEnabled="{Binding IsNotRefreshing}" AutomationProperties.Name="利用量を今すぐ確認"
                Content="{Binding RefreshButtonText}"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding VisibleProviders}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,10,10" MinHeight="176">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="12"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="6" Background="{Binding LogoTileBrush}">
                    <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="{Binding LogoGeometry}" Fill="{Binding LogoBrush}" Stretch="Uniform"/>
                    </Viewbox>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                             Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>

                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding RemainingDisplay}" FontSize="17" FontWeight="Bold" VerticalAlignment="Bottom"/>
                  <TextBlock Grid.Column="1" Text="{Binding PercentDisplay}" FontSize="17" FontWeight="Bold"
                             Foreground="{Binding StateBrush}" VerticalAlignment="Bottom"/>
                </Grid>

                <ProgressBar Grid.Row="4" Height="8" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                             Foreground="{Binding StateBrush}" Background="#D9DEE8" BorderThickness="0"/>

                <TextBlock Grid.Row="6" Text="{Binding ResetDisplay}" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AutoDetail}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <wv2:WebView2 x:Name="GeminiUsageBrowser" Width="1" Height="1" Margin="-100,-100,0,0"
                  IsHitTestVisible="False" Focusable="False"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
  </Grid>
</Window>
